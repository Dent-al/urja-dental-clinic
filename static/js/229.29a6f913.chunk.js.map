import React, { useState } from 'react';
import { FaStar } from 'react-icons/fa';
import { createBooking, getAvailability } from '../services/booking';

const BookOnline = () => {
	const today = new Date();
	const [selectedDate, setSelectedDate] = useState(today);
	const [selectedSlot, setSelectedSlot] = useState('');
	const [bookedSlots, setBookedSlots] = useState([]);
	const [name, setName] = useState('');
	const [phone, setPhone] = useState('');
	const [paymentRequired, setPaymentRequired] = useState(false);
	const [amount, setAmount] = useState(300);
	const [confirmed, setConfirmed] = useState(false);
	const [loading, setLoading] = useState(false);
	const [errorMsg, setErrorMsg] = useState('');

	const addDays = (d, days) => {
		const n = new Date(d);
		n.setDate(n.getDate() + days);
		return n;
	};

	const dayLabel = (d) => d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' });

	const morningSlots = ['09:00 AM','09:30 AM','10:00 AM','10:30 AM','11:00 AM','11:30 AM'];
	const afternoonSlots = ['12:00 PM','12:30 PM','01:00 PM','01:30 PM','02:00 PM','02:30 PM','03:00 PM','03:30 PM'];
	const eveningSlots = ['04:00 PM','04:30 PM','05:00 PM','05:30 PM','06:00 PM','06:30 PM','07:00 PM','07:30 PM','08:00 PM'];

	const handleBook = (e) => {
		e.preventDefault();
		if (!selectedSlot) return alert('Please pick a time slot');
		const payload = {
			name: name || 'Guest',
			phone: phone || '',
			date: selectedDate.toISOString().split('T')[0],
			slot: selectedSlot,
			// payment
			paymentRequired: paymentRequired || undefined,
			amount: paymentRequired ? Number(amount) : undefined,
		};

						(async () => {
							if (loading) return; // guard against double submit
							setErrorMsg('');
							setLoading(true);
							try {
								const res = await createBooking(payload);
								if (res.success) {
									// if payment required and API returned checkout URL -> redirect
									const payment = res.data && res.data.payment;
									if (payment && payment.checkoutUrl) {
										// show brief message then redirect
										setLoading(true);
										window.location.href = payment.checkoutUrl;
										return;
									}
									setConfirmed(true);
									setTimeout(() => { setConfirmed(false); setName(''); setPhone(''); setSelectedSlot(''); }, 2500);
								} else {
									setErrorMsg(res.error || 'Booking failed');
								}
							} catch (err) {
								setErrorMsg(err && err.message ? err.message : 'Network error');
							} finally {
								setLoading(false);
							}
						})();
	};

	// fetch availability for selected date
	React.useEffect(() => {
		let mounted = true;
		const d = selectedDate.toISOString().split('T')[0];
		getAvailability(d).then(res => {
			if (!mounted) return;
			if (res.success && res.data && Array.isArray(res.data.booked)) {
				setBookedSlots(res.data.booked);
			} else {
				setBookedSlots([]);
			}
		}).catch(() => setBookedSlots([]));
		return () => { mounted = false; };
	}, [selectedDate]);

	return (
		<div className="min-h-screen bg-gray-50 py-12 flex items-start justify-center">
			<div className="w-full max-w-3xl">
				<div className="bg-white rounded-2xl shadow-lg overflow-hidden">
					<div className="p-6 border-b flex items-start justify-between">
						<div>
							<h3 className="text-xl font-bold text-blue-800">Pick a time slot</h3>
							<div className="mt-2 text-sm text-gray-600 flex items-center gap-2">
								<span className="px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">Clinic Appointment</span>
								<span className="ml-4 text-sm text-gray-800 font-semibold">₹ 300 fee <span className="text-gray-400 text-xs">(3.49 USD)</span></span>
							</div>
							<div className="mt-3 text-gray-700">
								<div className="font-semibold">Urja Dental Clinic</div>
								<div className="flex items-center gap-2 text-yellow-500 text-sm mt-1"><FaStar /><FaStar /><FaStar /><FaStar /><span className="text-gray-500 text-xs">4.6 Verified details</span></div>
								<div className="text-sm text-gray-500 mt-1">Chandigarh, India</div>
							</div>
						</div>
						<div className="text-right text-sm text-gray-500">&nbsp;</div>
					</div>

					<div className="p-6">
						{/* Date carousel */}
						<div className="flex items-center justify-between mb-4">
							<button onClick={() => setSelectedDate(addDays(selectedDate, -1))} className="text-gray-400 px-2">←</button>
							<div className="flex gap-4">
								{[0,1,2].map(i => {
									const d = addDays(selectedDate, i - 1);
									return (
										<button key={i} onClick={() => setSelectedDate(d)} className={`px-4 py-3 rounded-lg border ${d.toDateString() === selectedDate.toDateString() ? 'bg-blue-50 border-blue-200' : 'bg-white border-gray-100'} text-sm` }>
											<div className="text-xs text-gray-500">{d.toLocaleDateString(undefined, { weekday: 'short' })}</div>
											<div className="font-semibold">{d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}</div>
											<div className="text-xs text-green-500 mt-1">23 Slots Available</div>
										</button>
									);
								})}
							</div>
							<button onClick={() => setSelectedDate(addDays(selectedDate, +1))} className="text-gray-400 px-2">→</button>
						</div>

						{/* Slots grid */}
						<form onSubmit={handleBook}>
							<div className="mb-6">
								<h4 className="text-sm font-semibold text-gray-700 mb-2">Morning (6 slots)</h4>
								<div className="grid grid-cols-3 gap-3">
									{morningSlots.map(s => {
										const disabled = bookedSlots.includes(s);
										return (
											<button key={s} type="button" onClick={() => !disabled && setSelectedSlot(s)} disabled={disabled} className={`py-2 px-3 text-sm rounded-lg border ${disabled ? 'bg-gray-100 text-gray-400 border-gray-100 cursor-not-allowed' : (selectedSlot === s ? 'bg-white border-blue-500 text-blue-700 shadow-sm' : 'bg-white border-blue-200 text-blue-600')}`}>
												{s}
											</button>
										);
									})}
								</div>
							</div>

							<div className="mb-6">
								<h4 className="text-sm font-semibold text-gray-700 mb-2">Afternoon (8 slots)</h4>
								<div className="grid grid-cols-3 gap-3">
									{afternoonSlots.map(s => {
										const disabled = bookedSlots.includes(s);
										return (
											<button key={s} type="button" onClick={() => !disabled && setSelectedSlot(s)} disabled={disabled} className={`py-2 px-3 text-sm rounded-lg border ${disabled ? 'bg-gray-100 text-gray-400 border-gray-100 cursor-not-allowed' : (selectedSlot === s ? 'bg-white border-blue-500 text-blue-700 shadow-sm' : 'bg-white border-blue-200 text-blue-600')}`}>
												{s}
											</button>
										);
									})}
								</div>
							</div>

							<div className="mb-6">
								<h4 className="text-sm font-semibold text-gray-700 mb-2">Evening (9 slots)</h4>
								<div className="grid grid-cols-3 gap-3">
									{eveningSlots.map(s => {
										const disabled = bookedSlots.includes(s);
										return (
											<button key={s} type="button" onClick={() => !disabled && setSelectedSlot(s)} disabled={disabled} className={`py-2 px-3 text-sm rounded-lg border ${disabled ? 'bg-gray-100 text-gray-400 border-gray-100 cursor-not-allowed' : (selectedSlot === s ? 'bg-white border-blue-500 text-blue-700 shadow-sm' : 'bg-white border-blue-200 text-blue-600')}`}>
												{s}
											</button>
										);
									})}
								</div>
							</div>

							{/* Contact fields shown on small screens and as confirmation info */}
							<div className="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
								<input value={name} onChange={(e) => setName(e.target.value)} placeholder="Your name" className="px-3 py-3 rounded-lg border border-gray-200 w-full" />
								<input value={phone} onChange={(e) => setPhone(e.target.value)} placeholder="Phone number" className="px-3 py-3 rounded-lg border border-gray-200 w-full" />
							</div>

							<div className="flex items-center gap-3 mb-4">
								<label className="inline-flex items-center gap-2">
									<input type="checkbox" checked={paymentRequired} onChange={(e) => setPaymentRequired(e.target.checked)} className="form-checkbox" />
									<span className="text-sm">Online consultation (pay now)</span>
								</label>
								{paymentRequired && (
									<input type="number" value={amount} onChange={(e) => setAmount(Number(e.target.value || 0))} className="px-3 py-2 rounded-lg border border-gray-200 w-28" />
								)}
							</div>

							{errorMsg && (
								<div className="mb-3 text-sm text-red-600">{errorMsg}</div>
							)}

							{loading && (
								<div className="mb-3 text-sm text-gray-600">Processing booking... please wait.</div>
							)}

							<div className="flex flex-col md:flex-row items-center gap-4">
								<button type="submit" disabled={loading} className={`flex-1 py-3 rounded-full ${loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-blue-600 hover:shadow-lg'} text-white font-semibold`}>{loading ? 'Processing...' : (confirmed ? 'Booked ✓' : 'Book Appointment')}</button>
								<a href="#contact" className="text-sm text-blue-600">Contact Form</a>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	);
};

export default BookOnline;
