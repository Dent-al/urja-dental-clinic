import React from 'react';

function ClinicTour() {
	// coordinates used in other parts of the site
	const destLat = 30.7092421;
	const destLng = 76.722227;
	const mapsPlaceUrl = `https://www.google.com/maps/place/Urja+Dental+Clinic+-+Dental+Implants+%26+Cosmetic+Dentistry/@${destLat},${destLng},15z`;
	const directionsBase = 'https://www.google.com/maps/dir/?api=1';
	const origin = 'Chandigarh+Railway+Station';
	const drivingUrl = `${directionsBase}&origin=${origin}&destination=${destLat},${destLng}&travelmode=driving`;
	const transitUrl = `${directionsBase}&origin=${origin}&destination=${destLat},${destLng}&travelmode=transit`;
	const walkingUrl = `${directionsBase}&origin=${origin}&destination=${destLat},${destLng}&travelmode=walking`;

	return (
		<div className="min-h-screen bg-gradient-to-br from-white to-red-100 py-12">
			<div className="max-w-6xl mx-auto p-8 bg-white/80 rounded-3xl shadow-2xl border-2 border-red-100">
				<h1 className="text-4xl font-extrabold text-red-700 mb-4 text-center">Clinic Tour & Directions</h1>
				<p className="text-lg text-red-500 mb-6 text-center">Take a virtual tour of our clinic and find the best route from Chandigarh Railway Station.</p>

				<section className="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
					<div>
						<h2 className="text-xl font-semibold text-gray-800 mb-3">Our location</h2>
						<p className="text-gray-600 mb-4">SSS (Bay Shop) - 74, Sector - 60, Mohali - 160062. Phone: +91-8699969619</p>

						<a href={mapsPlaceUrl} target="_blank" rel="noopener noreferrer" className="inline-block mb-4">
							<iframe
								title="Urja Dental Clinic Location"
								src={`https://www.google.com/maps?q=${destLat},${destLng}&z=15&output=embed`}
								width="100%"
								height="300"
								style={{ border: 0, borderRadius: 12 }}
								loading="lazy"
								referrerPolicy="no-referrer-when-downgrade"
							/>
						</a>

						<div className="flex gap-3 flex-wrap">
							<a href={drivingUrl} target="_blank" rel="noopener noreferrer" className="px-4 py-2 rounded-full bg-red-600 text-white font-semibold">Directions (Car)</a>
							<a href={transitUrl} target="_blank" rel="noopener noreferrer" className="px-4 py-2 rounded-full bg-emerald-600 text-white font-semibold">Directions (Transit)</a>
							<a href={walkingUrl} target="_blank" rel="noopener noreferrer" className="px-4 py-2 rounded-full bg-sky-600 text-white font-semibold">Directions (Walk)</a>
							<a href={mapsPlaceUrl} target="_blank" rel="noopener noreferrer" className="px-4 py-2 rounded-full border border-gray-200">Open on Maps</a>
						</div>
					</div>

					<div>
						<h2 className="text-xl font-semibold text-gray-800 mb-3">Quick route guidance from Chandigarh Railway Station</h2>
						<ol className="list-decimal list-inside text-gray-700 space-y-2">
							<li>Exit Chandigarh Railway Station and take a pre-paid taxi or auto-rickshaw — it’s the simplest door-to-door option.</li>
							<li>Share the clinic address: "SSS (Bay Shop) - 74, Sector 60, Mohali" with the driver; most drivers know Sector 60 landmarks.</li>
							<li>By car or taxi the trip normally takes about 20–35 minutes depending on traffic. Use the "Directions (Car)" button above for a live route and ETA.</li>
							<li>If you prefer public transport, choose the transit directions in Google Maps; it will show available buses/metro options and transfers.</li>
							<li>For walking (only recommended for short legs), the walking directions button opens a pedestrian route — this may include higher-level walk segments near your last station stop.</li>
						</ol>

						<p className="text-sm text-gray-500 mt-4">Tip: share the Google Maps link with your driver or use the map to get turn-by-turn navigation on your phone. If you need a pickup, call <strong>+91-8699969619</strong> and we’ll assist.</p>
					</div>
				</section>

				<section className="mt-8">
					<h3 className="text-lg font-semibold text-gray-800 mb-2">Accessibility & parking</h3>
					<p className="text-gray-700">Our clinic entrance is at street level. Limited on-site parking is available nearby; for larger vehicles ask the staff to guide you to the nearest available parking. Taxis and app-cabs can be dropped at the clinic entrance.</p>
				</section>
			</div>
		</div>
	);
}

export default ClinicTour;
