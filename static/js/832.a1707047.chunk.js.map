import React from 'react';
import ThreeDCard from '../components/ThreeDCard';

function DentalTourism() {
	return (
			<div className="min-h-screen bg-white py-6 md:py-12">
				<div className="max-w-4xl mx-auto p-4 md:p-8 bg-white/80 rounded-3xl shadow-2xl border-2 border-red-100">
					<h1 className="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-center text-red-700 mb-6 md:mb-8">
						LEADING DENTAL TOURISM CLINIC OF TRICITY
					</h1>
					<div className="flex justify-center mb-6 md:mb-8 w-full relative">
						{/* Animated gradient background */}
						<div className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full md:w-[1200px] h-[300px] md:h-[700px] z-0 pointer-events-none" style={{ filter: 'blur(40px)', opacity: 0.7 }}>
							<div className="w-full h-full animate-gradient bg-gradient-to-br from-blue-200 via-pink-100 to-yellow-100 rounded-3xl"></div>
						</div>
						<div className="relative z-10 w-full flex justify-center">
							<ThreeDCard backgroundImage={process.env.PUBLIC_URL + '/dental-tourism-3d.png'} className="w-full" >
								<img
									src={process.env.PUBLIC_URL + '/dental-tourism-3d.png'}
									alt="3D Dental Tourism"
									className="rounded-2xl shadow-lg w-full"
									style={{ maxWidth: '100%', width: '100%', height: '220px', minHeight: '180px', objectFit: 'cover', display: 'block', margin: '0 auto' }}
									/* On md+ screens, use large size */
									sizes="(min-width: 768px) 1165px, 100vw"
								/>
							</ThreeDCard>
						</div>
					</div>
				</div>
				<div className="w-full px-2 sm:px-4 md:px-0 max-w-none text-base md:text-lg text-gray-800 leading-relaxed space-y-4 mt-6 md:mt-8 mx-auto">
					<p>Dental Tourism in India is leading Asia as a dental tourism destination. "Maintenance is the key factor in preventing diseases". It is necessary to keep immaculate oral hygiene and to come back for regular check-ups for maintaining your oral health. Our clinic is the one-stop solution for all your dental needs.</p>
					<p>At Urja Multispeciality Dental Clinic, we welcome foreign visitors for cost-effective dental care for patients needing specialized and advanced dental care in a short period of time.</p>
					<p>We have a lot of foreign tourists visiting our clinic for their dental treatment. From diagnosis, scaling, placing dental implants, crown, and bridges along with following up dental care all is done in a short time. By giving the patient the best results as possible.</p>
					<p>Special arrangements for pick and drop facility from the airport to hotel stay are made for persons visiting from abroad countries along with the best dental care.</p>
					<p>We partner with prominent travel agencies who take you on tour to various cities, backwaters, wildlife sanctuaries, monuments and places of historical importance in our country. Or you can choose a simple package and travel in and around the city. It's not just visiting the country of great epic history but also the right place to electrify your taste buds with the famous traditional Indian food. We value the money and time you invest in the dental tour.</p>
					<p>For more information please do not hesitate to contact us. Our clinic timings are flexible to match the requirements of dental tourists. We will provide you with an appointment time and date.</p>
					<p>For appointments, please email us at <a href="mailto:urjadentalclinic@gmail.com" className="text-blue-600 underline">urjadentalclinic@gmail.com</a> or contact us via phone.</p>
				</div>
		</div>
	);
}

export default DentalTourism;
