import React, { useState, useRef, useEffect, useCallback, useMemo } from 'react';

const CARD_W = 260;
const CARD_H = 360;
const RADIUS = 300;
const DRAG_SENSITIVITY = 0.5;
const INERTIA_FRICTION = 0.95;
const AUTOSPIN_SPEED = 0.08;
const IDLE_TIMEOUT = 2000;

const teamMembers = [
	{
		name: 'Dr. Shikha',
		role: 'Chief Dentist & Implantologist',
		age: 38,
		details: 'Expert in advanced dental implants and smile design.',
		img: 'https://randomuser.me/api/portraits/women/44.jpg',
	},
	{
		name: 'Dr. Rahul',
		role: 'Orthodontist',
		age: 42,
		details: 'Specialist in braces, Invisalign, and pediatric dentistry.',
		img: 'https://randomuser.me/api/portraits/men/46.jpg',
	},
	{
		name: 'Dr. Priya',
		role: 'Cosmetic Dentist',
		age: 35,
		details: 'Porcelain veneers and teeth whitening expert.',
		img: 'https://randomuser.me/api/portraits/women/47.jpg',
	},
	{
		name: 'Dr. Aman',
		role: 'Endodontist',
		age: 40,
		details: 'Painless root canal and restorative dentistry specialist.',
		img: 'https://randomuser.me/api/portraits/men/48.jpg',
	},
];


const Card = React.memo(({ src, name, specialty, age, transform, cardW, cardH, onClick, isSelected }) => (
	<div
		className="absolute"
		style={{
			width: cardW,
			height: cardH,
			transform,
			transformStyle: 'preserve-3d',
			willChange: 'transform',
			cursor: 'pointer',
			zIndex: isSelected ? 100 : undefined,
			boxShadow: isSelected ? '0 0 32px 8px #e53e3e55' : '0 4px 24px rgba(0,0,0,0.08)',
			animation: isSelected ? 'floatCard 1.5s ease-in-out infinite' : undefined,
			transition: 'box-shadow 0.3s',
			borderRadius: '20px',
			overflow: 'hidden',
		}}
		onClick={onClick}
	>
		<div
			className="w-full h-full relative"
			style={{ backfaceVisibility: 'hidden', position: 'relative', width: '100%', height: '100%' }}
		>
			<img
				src={src}
				alt={name}
				width={cardW}
				height={cardH}
				className="w-full h-full object-cover"
				loading="lazy"
				draggable="false"
				style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%' }}
			/>
			<div
				className="absolute bottom-0 left-0 w-full px-4 py-3"
				style={{
					background: 'rgba(255,255,255,0.18)',
					backdropFilter: 'blur(12px)',
					borderTopLeftRadius: '20px',
					borderTopRightRadius: '20px',
					color: '#222',
					boxShadow: '0 -2px 16px 0 rgba(0,0,0,0.10)',
				}}
			>
				<div className="font-bold text-lg text-blue-700" style={{wordBreak:'break-word'}}>{name}</div>
				<div className="text-sm text-gray-600">Age: {age}</div>
				<div className="text-sm text-red-600 font-semibold">{specialty}</div>
			</div>
		</div>
		<style>{`
			@keyframes floatCard {
				0% { transform: translateY(0); }
				50% { transform: translateY(-16px); }
				100% { transform: translateY(0); }
			}
		`}</style>
	</div>
));
Card.displayName = 'Card';


const OurTeam = () => {
	const [selected, setSelected] = useState(null);
	const parentRef = useRef(null);
	const wheelRef = useRef(null);
	const rotationRef = useRef(0);
	const velocityRef = useRef(0);
	const isDraggingRef = useRef(false);
	const dragStartRef = useRef(0);
	const initialRotationRef = useRef(0);
	const lastInteractionRef = useRef(Date.now());
	const animationFrameRef = useRef(null);

	useEffect(() => {
		const animate = () => {
			if (!isDraggingRef.current) {
				if (Math.abs(velocityRef.current) > 0.01) {
					rotationRef.current += velocityRef.current;
					velocityRef.current *= INERTIA_FRICTION;
				} else if (Date.now() - lastInteractionRef.current > IDLE_TIMEOUT) {
					rotationRef.current += AUTOSPIN_SPEED;
				}
			}
			if (wheelRef.current) {
				wheelRef.current.style.transform = `rotateY(${rotationRef.current}deg)`;
			}
			animationFrameRef.current = requestAnimationFrame(animate);
		};
		animationFrameRef.current = requestAnimationFrame(animate);
		return () => {
			if (animationFrameRef.current) cancelAnimationFrame(animationFrameRef.current);
		};
	}, []);

	const handleDragStart = useCallback((clientX) => {
		lastInteractionRef.current = Date.now();
		isDraggingRef.current = true;
		velocityRef.current = 0;
		dragStartRef.current = clientX;
		initialRotationRef.current = rotationRef.current;
	}, []);
	const handleDragMove = useCallback((clientX) => {
		if (!isDraggingRef.current) return;
		lastInteractionRef.current = Date.now();
		const deltaX = clientX - dragStartRef.current;
		const newRotation = initialRotationRef.current + deltaX * DRAG_SENSITIVITY;
		velocityRef.current = newRotation - rotationRef.current;
		rotationRef.current = newRotation;
	}, []);
	const handleDragEnd = useCallback(() => {
		isDraggingRef.current = false;
		lastInteractionRef.current = Date.now();
	}, []);
	const onMouseDown = (e) => handleDragStart(e.clientX);
	const onMouseMove = (e) => handleDragMove(e.clientX);
	const onTouchStart = (e) => handleDragStart(e.touches[0].clientX);
	const onTouchMove = (e) => handleDragMove(e.touches[0].clientX);

	const cards = useMemo(() => teamMembers.map((member, idx) => {
		const angle = (idx * 360) / teamMembers.length;
		return {
			key: idx,
			...member,
			transform: `rotateY(${angle}deg) translateZ(${RADIUS}px)`
		};
	}), []);

	return (
		<div className="min-h-screen bg-white flex flex-col items-center justify-center">
			<h2 className="text-4xl md:text-5xl font-extrabold text-red-700 mb-2 text-center drop-shadow-lg" style={{marginTop: '8px'}}>Meet Our Team</h2>
					<div
						ref={parentRef}
						className="w-full flex items-center justify-center overflow-hidden cursor-grab active:cursor-grabbing"
					style={{ userSelect: 'none', minHeight: 400, marginTop: '-140px' }}
						onMouseDown={onMouseDown}
						onMouseMove={onMouseMove}
						onMouseUp={handleDragEnd}
						onMouseLeave={handleDragEnd}
						onTouchStart={onTouchStart}
						onTouchMove={onTouchMove}
						onTouchEnd={handleDragEnd}
					>
				<div
					className="relative"
					style={{
						perspective: 1500,
						perspectiveOrigin: 'center',
						width: Math.max(CARD_W * 1.5, RADIUS * 2.2),
						height: Math.max(CARD_H * 1.8, RADIUS * 1.5),
					}}
				>
					<div
						ref={wheelRef}
						className="relative"
						style={{
							width: CARD_W,
							height: CARD_H,
							transformStyle: 'preserve-3d',
							willChange: 'transform',
							position: 'absolute',
							left: '50%',
							top: '50%',
							marginLeft: -CARD_W / 2,
							marginTop: -CARD_H / 2,
						}}
					>
						{cards.map(card => (
							<Card
								key={card.key}
								src={card.img}
								name={card.name}
								specialty={card.role}
								age={card.age}
								transform={card.transform}
								cardW={CARD_W}
								cardH={CARD_H}
								onClick={() => setSelected(card)}
								isSelected={selected && selected.key === card.key}
							/>
						))}
					</div>
				</div>
			</div>
					{/* Modern, humanized team description below carousel */}
									<div className="w-full flex justify-center mt-8 mb-2">
										<div className="w-full bg-white bg-opacity-90 rounded-2xl shadow-2xl px-4 md:px-12 py-10 text-left text-base md:text-xl font-medium text-blue-700 leading-relaxed" style={{backdropFilter:'blur(8px)'}}>
											Welcome to Urja Multispeciality Dental Clinic, where your smile is our passion and your comfort is our priority. Our team is a blend of highly skilled dental professionals, each bringing years of experience, advanced training, and a genuine love for helping people. We believe that dentistry is not just about teeth—it’s about people, relationships, and building trust. From the moment you walk through our doors, you’ll notice the difference: a warm greeting, a friendly atmosphere, and a team that truly listens to your concerns and goals.
											<br /><br />
											Our clinic is equipped with the latest dental technology, allowing us to provide precise, gentle, and effective treatments for every age and need. Whether you’re here for a routine cleaning, a cosmetic transformation, or a complex procedure, our doctors and staff work together to ensure you feel informed, comfortable, and cared for at every step. We take time to explain your options, answer your questions, and tailor every treatment to your unique needs and preferences.
											<br /><br />
											What sets us apart is our commitment to a truly humanized approach. We understand that visiting the dentist can be stressful, so we go above and beyond to create a relaxing environment. Our team is trained not only in clinical excellence but also in empathy, communication, and patient education. We celebrate every smile, every milestone, and every story—because we know that dental health is deeply connected to overall well-being and confidence.
											<br /><br />
											At Urja, you’ll find specialists in implantology, orthodontics, cosmetic dentistry, endodontics, and more—all working together to deliver comprehensive care under one roof. Our doctors regularly attend national and international conferences, staying at the forefront of dental innovation and best practices. We use digital imaging, painless anesthesia techniques, and minimally invasive procedures to make your experience as smooth and effective as possible.
											<br /><br />
											But what truly makes us proud is the bond we build with our patients. Many families have trusted us for generations, and we cherish the relationships that grow over time. We believe in transparency, honesty, and ethical care—no hidden fees, no unnecessary treatments, just honest advice and genuine support. Our staff is always available to help with scheduling, insurance, and any special requests, making your journey easy and stress-free.
											<br /><br />
											We invite you to experience dentistry the Urja way: modern, compassionate, and deeply personal. Whether you’re a new patient or a longtime friend, we’re here to help you achieve your healthiest, brightest smile. Thank you for choosing us as your dental home. We look forward to welcoming you and your family, and to being a part of your journey to lifelong oral health and happiness.
										</div>
							</div>
					{/* Selected Card Overlay */}
					{selected && (
													<div className="fixed inset-0 flex items-center justify-center z-50 bg-black bg-opacity-40 animate-fadeIn">
														<div className="relative flex w-[420px] h-[620px] md:w-[700px] md:h-[620px] rounded-2xl shadow-2xl overflow-hidden animate-popIn" style={{ animation: 'popIn 0.5s', background: 'rgba(255,255,255,0.08)', backdropFilter: 'blur(18px)', maxWidth: '98vw', maxHeight: '98vh' }}>
													<button
														className="absolute top-4 right-4 text-2xl text-gray-500 hover:text-red-600 font-bold"
														onClick={() => setSelected(null)}
														aria-label="Close"
														style={{ zIndex: 10 }}
													>
														&times;
													</button>
													{/* Left: Large Image */}
													<div className="w-1/2 h-full flex items-center justify-center bg-transparent">
														<img
															src={selected.image}
															alt={selected.name}
															className="rounded-xl object-cover w-[90%] h-[90%] shadow-lg"
															style={{ minWidth: '140px', minHeight: '320px', maxWidth: '95%', maxHeight: '95%' }}
														/>
													</div>
													{/* Right: Glassmorphism Details */}
													<div className="w-1/2 h-full flex flex-col justify-center p-6 text-left text-white relative"
														style={{ background: 'rgba(255,255,255,0.18)', backdropFilter: 'blur(24px)', borderTopRightRadius: '1.25rem', borderBottomRightRadius: '1.25rem', boxShadow: '0 8px 32px 0 rgba(31, 38, 135, 0.37)' }}>
														<h3 className="text-2xl font-bold mb-3 drop-shadow-lg">{selected.name}</h3>
														<div className="text-lg text-gray-200 mb-1">Age: {selected.age}</div>
														<div className="text-lg text-red-200 font-semibold mb-2">{selected.role}</div>
														<p className="text-base md:text-lg whitespace-pre-line leading-relaxed" style={{ maxHeight: '340px', overflowY: 'auto' }}>{selected.details}</p>
													</div>
													<style>{`
														@keyframes popIn {
															0% { transform: scale(0.7); opacity: 0; }
															100% { transform: scale(1); opacity: 1; }
														}
														@keyframes fadeIn {
															0% { opacity: 0; }
															100% { opacity: 1; }
														}
													`}</style>
												</div>
											</div>
			)}
		</div>
	);
};

export default OurTeam;
