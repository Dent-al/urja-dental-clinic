import React, { useEffect, useState, useCallback } from 'react';
import img1 from '../assets/highlight1.png';
import img2 from '../assets/highlight2.png';
import img3 from '../assets/highlight3.png';
import img4 from '../assets/highlight4.png';
import img5 from '../assets/highlight5.png';

function CasesPictures() {
		// gallery images
		const images = [img1, img2, img3, img4, img5, img1, img2, img3, img4];
		const captions = [
			'Anterior composite bonding — natural shade match',
			'Posterior restorations — conservative composite',
			'Cosmetic contouring & polishing',
			'Smile-friendly minimally invasive prep',
			'Preventive sealant and polish',
		];
	const [modalOpen, setModalOpen] = useState(false);
	const [current, setCurrent] = useState(0);

	useEffect(() => {
		const io = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) entry.target.classList.add('is-visible');
			});
		}, { threshold: 0.12 });
		document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
		return () => io.disconnect();
	}, []);

	const openModal = useCallback((idx) => {
		setCurrent(idx);
		setModalOpen(true);
		document.body.style.overflow = 'hidden';
	}, []);

	const closeModal = useCallback(() => {
		setModalOpen(false);
		document.body.style.overflow = '';
	}, []);

	const next = useCallback(() => setCurrent((c) => (c + 1) % images.length), [images.length]);
	const prev = useCallback(() => setCurrent((c) => (c - 1 + images.length) % images.length), [images.length]);

	useEffect(() => {
		function onKey(e) {
			if (!modalOpen) return;
			if (e.key === 'ArrowRight') next();
			if (e.key === 'ArrowLeft') prev();
			if (e.key === 'Escape') closeModal();
		}
		window.addEventListener('keydown', onKey);
		return () => window.removeEventListener('keydown', onKey);
	}, [modalOpen, next, prev, closeModal]);

	return (
		<div className="min-h-screen bg-gradient-to-br from-white to-red-100 py-12">
			<div className="max-w-7xl mx-auto p-8 bg-white/80 rounded-3xl shadow-2xl border-2 border-red-100">
				<h1 className="text-4xl font-extrabold text-red-700 mb-4 text-center">Cases Pictures</h1>
				<p className="text-lg text-red-500 mb-4 text-center">Below are some of the cases we have completed — click any image to open the gallery (no swipe required).</p>

				<div className="text-center mb-4">
					<button onClick={() => openModal(0)} className="px-5 py-2 rounded-full bg-red-600 text-white font-semibold">View Gallery</button>
				</div>

				<section className="cases-grid mt-6">
					{images.map((src, idx) => (
									<figure
							key={idx}
							className="case-card reveal cursor-pointer"
							style={{ ['--i']: idx }}
							onClick={() => openModal(idx)}
						>
										<img loading="lazy" src={src} alt={`case-${idx + 1}`} className="case-img" />
										<figcaption className="case-caption">{captions[idx % captions.length] || `Case ${idx + 1}`}</figcaption>
						</figure>
					))}
				</section>
			</div>

			{/* Modal gallery (no swipe required) */}
			{modalOpen && (
				<div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4" role="dialog" aria-modal="true">
					<div className="relative max-w-4xl w-full rounded-xl overflow-hidden bg-white">
						<button onClick={closeModal} aria-label="Close gallery" className="absolute right-3 top-3 z-20 bg-white/80 rounded-full p-2">✕</button>
						<div className="flex items-center gap-2">
							<button onClick={prev} aria-label="Previous image" className="p-4 text-2xl">‹</button>
										<div className="flex-1">
											<img loading="lazy" src={images[current]} alt={`case-large-${current+1}`} className="w-full h-[60vh] object-contain bg-black" />
											<div className="p-3 text-sm text-gray-700 bg-white">{captions[current % captions.length] || `Case ${current + 1}`}</div>
										</div>
							<button onClick={next} aria-label="Next image" className="p-4 text-2xl">›</button>
						</div>
						<div className="p-4 text-center bg-gray-50">
							<div className="font-semibold text-gray-800">Case {current + 1} of {images.length}</div>
						</div>
					</div>
				</div>
			)}

			<style>{`
	.cases-grid { display:grid; grid-template-columns: repeat(1, minmax(0,1fr)); gap: 1rem; }
	@media(min-width:640px){ .cases-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
	@media(min-width:1024px){ .cases-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }

	.case-card { position: relative; overflow: hidden; border-radius: 1rem; background: linear-gradient(180deg, rgba(255,255,255,0.6), rgba(255,255,255,0.4)); box-shadow: 0 8px 20px rgba(0,0,0,0.08); transform: translateZ(0); }
	.case-img { width:100%; height:220px; object-fit:cover; display:block; transition: transform 500ms ease, filter 350ms ease; }
	.case-card:hover .case-img { transform: scale(1.06) translateY(-6px); filter: saturate(1.06); }
	.case-caption { position:absolute; left:12px; bottom:12px; padding:6px 10px; background: rgba(255,255,255,0.75); border-radius:12px; font-size:0.85rem; color:#9b2c2c; font-weight:600; }

	/* floating-like continuous motion: subtle vertical bob + slow rotate */
	.case-card { animation: floaty 6s ease-in-out infinite; animation-delay: calc(var(--i) * -0.35s); }
	@keyframes floaty {
		0% { transform: translateY(0) rotate(-0.2deg); }
		25% { transform: translateY(-6px) rotate(0.6deg); }
		50% { transform: translateY(0) rotate(-0.2deg); }
		75% { transform: translateY(6px) rotate(0.2deg); }
		100% { transform: translateY(0) rotate(-0.2deg); }
	}

	/* reveal entrance */
	.reveal { opacity: 0; transform: translateY(18px) scale(0.996); transition: opacity 520ms cubic-bezier(.22,.9,.36,1), transform 520ms cubic-bezier(.22,.9,.36,1); }
	.reveal.is-visible { opacity:1; transform: translateY(0) scale(1); }

	/* modal adjustments */
	@media (max-width: 640px) {
		.case-img { height:160px; }
		.fixed img { height: 50vh; }
	}

	/* reduce motion for users who prefer reduced motion */
	@media (prefers-reduced-motion: reduce) {
		.case-card { animation: none; }
		.case-img { transition: none; }
	}
			`}</style>
		</div>
	);
}

export default CasesPictures;
