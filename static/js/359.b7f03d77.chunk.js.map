import React, { useEffect, useState, useCallback } from 'react';
import img1 from '../assets/13.png';
import img2 from '../assets/40.png';
import img3 from '../assets/49.png';
import img4 from '../assets/52.png';
import img5 from '../assets/highlight5.png';

function CasesPictures() {
		// gallery images
		const images = [img1, img2, img3, img4, img5, img1, img2, img3, img4];
		const captions = [
			'Anterior composite bonding — natural shade match',
			'Posterior restorations — conservative composite',
			'Cosmetic contouring & polishing',
			'Smile-friendly minimally invasive prep',
			'Preventive sealant and polish',
		];
	const [modalOpen, setModalOpen] = useState(false);
	const [current, setCurrent] = useState(0);

	useEffect(() => {
		const io = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) entry.target.classList.add('is-visible');
			});
		}, { threshold: 0.12 });
		document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
		return () => io.disconnect();
	}, []);

	const openModal = useCallback((idx) => {
		setCurrent(idx);
		setModalOpen(true);
		document.body.style.overflow = 'hidden';
	}, []);

	const closeModal = useCallback(() => {
		setModalOpen(false);
		document.body.style.overflow = '';
	}, []);

	const next = useCallback(() => setCurrent((c) => (c + 1) % images.length), [images.length]);
	const prev = useCallback(() => setCurrent((c) => (c - 1 + images.length) % images.length), [images.length]);

	useEffect(() => {
		function onKey(e) {
			if (!modalOpen) return;
			if (e.key === 'ArrowRight') next();
			if (e.key === 'ArrowLeft') prev();
			if (e.key === 'Escape') closeModal();
		}
		window.addEventListener('keydown', onKey);
		return () => window.removeEventListener('keydown', onKey);
	}, [modalOpen, next, prev, closeModal]);

		return (
			<div className="min-h-screen bg-gradient-to-br from-white to-red-100 py-6 md:py-12">
				<div className="max-w-7xl mx-auto p-2 sm:p-8 bg-white/80 rounded-3xl shadow-2xl border-2 border-red-100">
					<h1 className="text-2xl sm:text-4xl font-extrabold text-red-700 mb-3 sm:mb-4 text-center">Cases Pictures</h1>
					<p className="text-base sm:text-lg text-red-500 mb-3 sm:mb-4 text-center">Below are some of the cases we have completed — click any image to open the gallery (no swipe required).</p>

					<div className="text-center mb-3 sm:mb-4">
						<button onClick={() => openModal(0)} className="px-4 sm:px-5 py-2 rounded-full bg-red-600 text-white font-semibold">View Gallery</button>
					</div>

					<section className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6 mt-4 sm:mt-6">
						{images.map((src, idx) => (
							<figure
								key={idx}
								className="relative overflow-hidden rounded-2xl bg-white bg-opacity-60 shadow-lg cursor-pointer reveal"
								style={{ ['--i']: idx }}
								onClick={() => openModal(idx)}
							>
								<img loading="lazy" src={src} alt={`case-${idx + 1}`} className="w-full h-36 sm:h-48 object-cover transition-transform duration-500 ease-in-out" />
								<figcaption className="absolute left-2 bottom-2 px-2 py-1 bg-white/80 rounded-lg text-xs sm:text-sm text-red-700 font-semibold shadow">{captions[idx % captions.length] || `Case ${idx + 1}`}</figcaption>
							</figure>
						))}
					</section>
				</div>

				{/* Modal gallery (no swipe required) */}
				{modalOpen && (
					<div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-2 sm:p-4" role="dialog" aria-modal="true">
						<div className="relative max-w-2xl sm:max-w-4xl w-full rounded-xl overflow-hidden bg-white">
							<button onClick={closeModal} aria-label="Close gallery" className="absolute right-2 top-2 sm:right-3 sm:top-3 z-20 bg-white/80 rounded-full p-2">✕</button>
							<div className="flex flex-col sm:flex-row items-center gap-2">
								<button onClick={prev} aria-label="Previous image" className="p-3 sm:p-4 text-xl sm:text-2xl">‹</button>
								<div className="flex-1">
									<img loading="lazy" src={images[current]} alt={`case-large-${current+1}`} className="w-full h-[40vh] sm:h-[60vh] object-contain bg-black" />
									<div className="p-2 sm:p-3 text-xs sm:text-sm text-gray-700 bg-white">{captions[current % captions.length] || `Case ${current + 1}`}</div>
								</div>
								<button onClick={next} aria-label="Next image" className="p-3 sm:p-4 text-xl sm:text-2xl">›</button>
							</div>
							<div className="p-2 sm:p-4 text-center bg-gray-50">
								<div className="font-semibold text-gray-800 text-xs sm:text-base">Case {current + 1} of {images.length}</div>
							</div>
						</div>
					</div>
				)}
			</div>
		);
}

export default CasesPictures;
