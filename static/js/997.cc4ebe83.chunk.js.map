import React, { useEffect } from 'react';
import AnimatedBackground from '../components/AnimatedBackground.jsx';
import { Link } from 'react-router-dom';
import img1 from '../assets/highlight1.png';
import img2 from '../assets/highlight2.png';
import img3 from '../assets/highlight3.png';
import img4 from '../assets/highlight4.png';
import img5 from '../assets/highlight5.png';

export default function HolisticDentist() {
	useEffect(() => {
		const io = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) entry.target.classList.add('is-visible');
			});
		}, { threshold: 0.12 });
		document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
		return () => io.disconnect();
	}, []);

	const gallery = [img1, img2, img3, img4, img5];

	return (
		<div className="relative min-h-screen bg-white overflow-x-hidden">
			<div className="absolute inset-0 -z-30 opacity-95 pointer-events-none" aria-hidden>
				<AnimatedBackground />
			</div>

			<header className="relative max-w-6xl mx-auto px-6 py-20 text-center">
				<div className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-amber-50 to-white/60 backdrop-blur-sm px-8 py-12 shadow-2xl">
					<div className="absolute -left-20 -top-12 opacity-30 pointer-events-none organic-shape" aria-hidden>
						<svg width="360" height="360" viewBox="0 0 360 360" xmlns="http://www.w3.org/2000/svg">
							<defs>
								<linearGradient id="lg1" x1="0" x2="1">
									<stop offset="0%" stopColor="#FFEDD5" />
									<stop offset="100%" stopColor="#FEF3C7" />
								</linearGradient>
							</defs>
							<g fill="url(#lg1)">
								<path d="M80,10 C150,-20 250,30 300,80 C350,130 320,220 260,260 C200,300 120,290 70,240 C20,190 10,60 80,10z" />
							</g>
						</svg>
					</div>

					<h1 className="text-3xl md:text-4xl font-extrabold text-amber-900 mb-3 reveal">Holistic Dentistry — Whole-person dental care</h1>
					<p className="text-gray-700 max-w-3xl mx-auto mb-6 reveal">We blend modern dental science with whole-body awareness. Our holistic care focuses on your oral health as part of overall wellbeing — minimizing toxins, supporting function and appearance, and planning treatments that respect your whole-body health.</p>

					<div className="flex justify-center gap-4 mb-6 reveal">
						<Link to="/book-online" className="inline-block">
							<button className="px-6 py-2 rounded-full bg-amber-600 text-white font-semibold shadow hover:scale-105 transition">Book Consultation</button>
						</Link>
						<a href="#gallery" className="px-6 py-2 rounded-full border border-amber-600 text-amber-700 font-semibold hover:bg-amber-50 transition">See Gallery</a>
					</div>

					<div className="mt-4 reveal">
						<svg width="260" height="36" viewBox="0 0 260 36" xmlns="http://www.w3.org/2000/svg">
							<g fill="#fff" opacity="0.04">
								<rect x="0" y="0" width="260" height="36" rx="10" />
							</g>
						</svg>
					</div>
				</div>
			</header>

			<main className="max-w-6xl mx-auto px-6 pb-16">
				<section id="gallery" className="mb-12">
					<h2 className="text-2xl md:text-3xl font-bold text-amber-800 mb-6 text-center reveal">Our Clinic & Cases</h2>
					<div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
						{gallery.map((src, i) => (
							<figure key={i} className="reveal rounded-2xl overflow-hidden shadow-lg transform transition hover:-translate-y-2" style={{ ['--delay']: `${i * 80}ms` }}>
								<img src={src} alt={`holistic-${i+1}`} className="w-full h-56 object-cover" />
								<figcaption className="p-3 bg-white">
									<p className="text-sm text-gray-600">Illustrative case {i + 1} — comfortable, conservative care.</p>
								</figcaption>
							</figure>
						))}
					</div>
				</section>

				<section className="prose lg:prose-lg max-w-none text-gray-700 reveal">
					<h3 className="text-2xl font-bold text-amber-800 mb-4">A holistic approach to dental care</h3>
					<p>
						Holistic dentistry recognizes that your mouth is not an isolated system — it interacts with your breathing, digestion, sleep, posture and immune system. At our clinic we start by listening. We take a careful health history, review systemic factors, and use minimally invasive techniques when possible so treatments support overall health rather than compromise it.
					</p>

					<p>
						Our treatment plans prioritize preservation of natural tooth structure and use materials and protocols selected for biocompatibility. Where restorations are needed we favor adhesive, tooth‑colored options and discuss the timing of any prosthetic work so it fits the patient’s broader health goals. We also coordinate with medical colleagues when dental findings suggest systemic concerns — this continuity improves outcomes and patient safety.
					</p>

					<p>
						Prevention is central to holistic care. We teach techniques to reduce decay and gum disease that go beyond basic brushing: occlusion (how your teeth meet), airway health, sleep position, diet, and stress all influence oral inflammation and wear. Our hygienists provide personalized coaching and non‑abrasive polishing methods that protect enamel and reduce sensitivity. Fluoride, remineralizing agents, and sealants are used judiciously based on risk.
					</p>

					<p>
						Sensitivity and anxiety are common barriers to care. We offer gentler anesthesia protocols, talk‑through sedation alternatives, and take time to de‑stress the experience. For anxious patients we provide relaxation measures and a stepwise care plan that keeps visits short and predictable. Minimizing trauma during treatment speeds recovery and supports long‑term oral health.
					</p>

					<p>
						Material selection matters in holistic dentistry. We review the evidence and patient preferences when discussing amalgam removal, metal restorations, or implant choices. When removing existing metallic restorations we follow safe‑removal protocols to reduce particulate exposure. For replacements we prioritize ceramics, composite resins and implant systems shown to be biocompatible and easy to maintain.
					</p>

					<p>
						Cosmetic goals are balanced with function. A beautiful smile should work comfortably for chewing and speaking. Our aesthetic cases incorporate digital planning and mock‑ups so patients can preview outcomes. We avoid aggressive tooth reduction and use conservative bonding techniques whenever possible to preserve vitality and structure.
					</p>

					<p>
						Holistic dentistry also incorporates lifestyle counseling. Dietary sugars and acids accelerate enamel loss and inflammation; we provide practical, evidence‑based guidance to reduce risk while still enjoying food. Sleep and airway health are assessed because obstructed breathing affects facial development, periodontal health and systemic wellness. When airway issues are suspected, we coordinate sleep studies or refer to appropriate specialists.
					</p>

					<p>
						Our goal is to create durable, comfortable results that integrate with your life. That means clear consent, shared decision‑making and follow‑ups focused on maintenance and prevention. We measure outcomes with photos and digital records and adjust plans as biology and life change. If you’re seeking care that treats you as a whole person, book a consultation so we can explore the gentlest, most effective path for your smile and health.
					</p>
				</section>
			</main>

			<style>{`
	.reveal { opacity: 0; transform: translateY(22px) scale(0.998); will-change: transform, opacity; }
	.reveal.is-visible { animation: revealIn 660ms cubic-bezier(.22,.9,.36,1) both; }
	@keyframes revealIn { from { opacity: 0; transform: translateY(22px) scale(0.998); } to { opacity: 1; transform: translateY(0) scale(1); } }
	.reveal { animation-delay: var(--delay, 0ms); }

	/* organic floating accent */
	.organic-shape { animation: slowDrift 9s ease-in-out infinite; }
	@keyframes slowDrift { 0% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-10px) rotate(2deg); } 100% { transform: translateY(0) rotate(-2deg); } }

	/* reduced motion preference */
	@media (prefers-reduced-motion: reduce) { .organic-shape, .reveal.is-visible { animation: none !important; } }

	header .backdrop-blur-sm { backdrop-filter: blur(6px); }
			`}</style>
		</div>
	);
}
