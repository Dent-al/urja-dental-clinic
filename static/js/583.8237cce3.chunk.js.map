import React from 'react';

const reviews = [
	{ name: 'Vikas Kumar', rating: 5, text: "I recently got my multiple tooth fillings done at, Urja Dental Clinic and I'm extremely happy and satisfied with the entire experience! The team is highly professional, caring and made sure I was comfortable throughout the procedure.", time: '2 months ago' },
	{ name: 'Sanju Sood', rating: 5, text: 'I had an amazing experience at Urja Multispeciality Dental Clinic, Mohali. The team of specialists is highly skilled, professional, and truly dedicated to patient care.', time: '3 weeks ago' },
	{ name: 'Anonymous', rating: 5, text: 'Excellent dental care! The clinic is clean, well-equipped, and the staff is very friendly. Dr. explains everything clearly and makes the treatment comfortable and painless.', time: '1 month ago' }
];

function Stars({ n }) {
	return (
		<span className="text-yellow-400" aria-hidden>
			{Array.from({ length: 5 }).map((_, i) => (
				<span key={i} className={i < n ? 'opacity-100' : 'opacity-30'}>★</span>
			))}
		</span>
	);
}

function HappyPatients() {
	return (
		<div className="min-h-screen bg-gradient-to-br from-white to-red-100 py-12">
			<div className="max-w-6xl mx-auto p-8 bg-white/90 rounded-3xl shadow-2xl border-2 border-red-100">
				<h1 className="text-4xl font-extrabold text-red-700 mb-2 text-center">Happy Patients</h1>
				<p className="text-lg text-red-500 mb-8 text-center">Real Google reviews from patients who trusted us with their smiles.</p>

				<div className="grid grid-cols-1 md:grid-cols-3 gap-6">
					{reviews.map((r, idx) => (
						<article key={idx} className="p-4 rounded-xl bg-white shadow hover:shadow-lg transition">
							<div className="flex items-center justify-between mb-3">
								<div className="flex items-center gap-3">
									<div className="w-10 h-10 rounded-full bg-purple-600 text-white flex items-center justify-center font-bold">{r.name[0]}</div>
									<div>
										<div className="font-semibold text-gray-800">{r.name}</div>
										<div className="text-xs text-gray-500">{r.time}</div>
									</div>
								</div>
								<Stars n={r.rating} />
							</div>
							<p className="text-gray-700 text-sm">{r.text}</p>
						</article>
					))}
				</div>

				<div className="mt-8 text-center">
					<a className="inline-block px-6 py-2 rounded-full border border-red-200 text-red-600 font-semibold hover:bg-red-50" href="https://maps.app.goo.gl/5qStBm9jx6mUjY3z8" target="_blank" rel="noopener noreferrer">Read all Google reviews</a>
				</div>
			</div>
		</div>
	);
}

export default HappyPatients;
